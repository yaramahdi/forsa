PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

JWT_SECRET=your_super_secret_key

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD_HASH=<bcrypt_hash_of_password>

# Comma-separated list of allowed frontend origins.
# Add your production domain here before deploying.
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://forsa.ps
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting — requests per IP per window. Remove to use the defaults below.
RATE_LIMIT_GENERAL_MAX=100        # 15-min window, all /api/* routes
RATE_LIMIT_LOGIN_MAX=5            # 15-min window, login endpoints (failed requests only)
RATE_LIMIT_REGISTER_MAX=3         # 1-hour window, /register
RATE_LIMIT_SERVICE_REQUEST_MAX=5  # 10-min window, POST /service-requests
